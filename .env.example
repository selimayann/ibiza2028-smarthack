# Copiază în .env și completează local. .env NU intră în git.
# Salt pentru device_id (hash-ul MAC-ului). Orice text lung, aleatoriu.
NETSCAN_SALT=
# Numele hotspotului echipei, ex. RSH-<nume-echipă>
NETSCAN_EXPECTED_SSID=
# Opțional: 1 = refuză scanarea dacă numele Wi-Fi nu poate fi citit (implicit doar avertisment)
NETSCAN_REQUIRE_SSID=
# Opțional: subrețele suplimentare permise, separate prin virgulă (implicit: subnetul curent)
NETSCAN_ALLOWLIST=
# Calea bazei de date cu istoricul
NETSCAN_DB_PATH=data/netscan.db
# Opțional: folderul cu fișierele nmap XML afișate în UI (implicit fixtures/validation).
# La demo-ul de istoric: folderul cu scanările din lab (scan_01_before.xml, scan_03_after.xml).
NETSCAN_SCANS_DIR=
# Opțional (D8): modelul AI local (Ollama pe 127.0.0.1, fără internet). Oprit dacă nu e 1.
NETSCAN_LOCAL_LLM=
# Modelul Ollama (implicit qwen2.5:7b); adresa e mereu doar 127.0.0.1.
NETSCAN_LOCAL_MODEL=
# Cât rămâne modelul local încărcat după o întrebare (implicit 30m). Pentru jurizare: 3h (ocupă ~5 GB RAM).
NETSCAN_LOCAL_KEEP_ALIVE=
