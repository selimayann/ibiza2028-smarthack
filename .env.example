# Copiază în .env și completează local. .env NU intră în git.
# Salt pentru device_id (hash-ul MAC-ului). Orice text lung, aleatoriu.
NETSCAN_SALT=
# Numele hotspotului echipei, ex. RSH-<nume-echipă>
NETSCAN_EXPECTED_SSID=
# 1 = refuză scanarea dacă numele Wi-Fi nu poate fi citit. Lasă 1: subnetul singur nu dovedește că ești pe
# hotspotul echipei (orice hotspot de iPhone e 172.20.10.0/28). Scanarea din aplicație și protecția live
# cer oricum numele Wi-Fi citit și egal cu NETSCAN_EXPECTED_SSID. Pe Windows, pornește Locația ca să se poată citi.
NETSCAN_REQUIRE_SSID=1
# Un VPN pornit (Tailscale, WireGuard, OpenVPN…) blochează scanarea și protecția live: oprește-l înainte.
# Opțional: doar ÎNGUSTEAZĂ subnetul curent (ex. 172.20.10.4/30). Intrările din afara lui sunt ignorate.
NETSCAN_ALLOWLIST=
# Opțional: IP-uri pe care ușa-capcană le ignoră (ex. laptopul care scanează), separate prin virgulă.
# Capcana e oricum oprită până o pornești (bifa din aplicație sau trap --confirm).
NETSCAN_TRAP_IGNORE=
# Calea bazei de date cu istoricul
NETSCAN_DB_PATH=data/netscan.db
# Opțional: folderul cu fișierele nmap XML afișate în UI (implicit fixtures/validation).
# La demo-ul de istoric: folderul cu scanările din lab (scan_01_before.xml, scan_03_after.xml).
NETSCAN_SCANS_DIR=
# Opțional (D8): modelul AI local (Ollama pe 127.0.0.1, fără internet). Oprit dacă nu e 1.
NETSCAN_LOCAL_LLM=
# Modelul Ollama (implicit qwen2.5:7b); adresa e mereu doar 127.0.0.1.
NETSCAN_LOCAL_MODEL=
# Cât rămâne modelul local încărcat după o întrebare (implicit 30m). Pentru jurizare: 3h (ocupă ~5 GB RAM).
NETSCAN_LOCAL_KEEP_ALIVE=
